# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Variables d'environnement locales (clés Supabase du compteur, etc.).
# Le modèle versionné est .env.example ; les vraies valeurs restent hors dépôt.
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
public/models/raw/
# Rigs de test générés (make-test-rig.mjs, make-test-dog.mjs) : outils de dev.
public/models/test_*.glb
public/models/animals/test_*.glb

# Pipeline PLATEAU : données brutes, archives téléchargées et intermédiaires.
# Les livrables (public/world/plateau/*.glb, manifest.json, route.json,
# LICENSE.md, build-report.json) sont, eux, versionnés.
.cache/
work/

# Échantillon CityGML synthétique : régénéré à la demande par
# scripts/plateau/make-sample.mjs (graine fixe, sortie identique).
data/plateau-sample/

# Caches Python des générateurs audio (melodies-gen, piano-melody-gen, …) et
# de l'atelier de voix, dont les modules s'importent entre eux.
scripts/__pycache__/
scripts/voice-lab/__pycache__/

# Essais de gravure (scripts/voice-lab/graver.py --essai) : des annonces
# assemblées pour être écoutées, jamais servies au jeu. Le cache de fragments,
# lui, EST versionné - sans quoi chaque regravure repartirait de zéro.
audio-src/essai/
# Textes exportés pour la gravure : reconstruits par `npm run voix:textes`.
audio-src/annonces.json

{
  "name": "yamanote-3d",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "seo:assets": "node scripts/seo-assets.mjs",
    "docs:platforms": "node scripts/platform-docs.mjs",
    "models:import": "node scripts/models-import.mjs",
    "animals:import": "node scripts/animals-import.mjs",
    "models:inspect": "node scripts/models-inspect.mjs",
    "voix:textes": "node --experimental-strip-types scripts/announcements-export.ts audio-src/annonces.json",
    "voix:lectures": "npm run voix:textes && python scripts/voice-lab/lectures.py audio-src/annonces.json audio-src/lectures.json",
    "voix:verifier": "python scripts/voice-lab/graver.py --verifier",
    "voix:variantes": "python scripts/voice-lab/graver.py --variantes",
    "voix:plan": "npm run voix:textes && python scripts/voice-lab/graver.py audio-src/annonces.json public/audio/announcements src/data/pa-manifest.ts --plan",
    "voix:essai": "npm run voix:textes && python scripts/voice-lab/graver.py audio-src/annonces.json public/audio/announcements src/data/pa-manifest.ts --essai",
    "voix:graver": "npm run voix:textes && python scripts/voice-lab/graver.py audio-src/annonces.json public/audio/announcements src/data/pa-manifest.ts",
    "test": "node --test \"tests/**/*.test.mjs\" \"tests/**/*.test.ts\"",
    "geo:loop": "node scripts/geo/fetch-loop.mjs && node scripts/geo-loop.mjs",
    "world:route:prototype": "node scripts/plateau/fetch-route.mjs",
    "world:sample:prototype": "node scripts/plateau/make-sample.mjs",
    "world:download:prototype": "node scripts/plateau/download.mjs",
    "world:convert:prototype": "node scripts/plateau/convert.mjs",
    "world:process:prototype": "node scripts/plateau/process.mjs",
    "world:optimize:prototype": "node scripts/plateau/optimize.mjs",
    "world:validate:prototype": "node scripts/plateau/validate.mjs",
    "world:build:prototype": "node scripts/plateau/build.mjs",
    "world:check:prototype": "node scripts/plateau/visual-check.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@supabase/supabase-js": "^2.111.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1",
    "tone": "^15.1.22",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.4.1",
    "@gltf-transform/extensions": "^4.4.1",
    "@gltf-transform/functions": "^4.4.1",
    "@types/earcut": "^3.0.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.3",
    "earcut": "^3.2.3",
    "fflate": "^0.8.3",
    "meshoptimizer": "^1.2.0",
    "oxlint": "^1.71.0",
    "playwright": "^1.62.0",
    "sharp": "^0.35.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
